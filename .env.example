# ── Core GCP ──────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
PORT=8080
LOG_LEVEL=INFO

# ── BigQuery ──────────────────────────────────────────────────────────────────
# New dataset for v2.2 dynamic schema (keep mcp_mobility until verified)
BIGQUERY_DATASET=ev_advisor_core
BIGQUERY_LOCATION=US
BQ_EXECUTOR_WORKERS=4

# ── External provider feature flags ──────────────────────────────────────────
# Open Charge Map — global EV charger registry (free without key, key raises limits)
ENABLE_OCM=true
OPENCHARGEMAP_API_KEY=

# OSM / Overpass — parking lots, mobility hubs, neighborhoods (always free)
ENABLE_OSM_OVERPASS=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Google Places — optional EV enrichment (requires key; free tier 10k/month)
# Cost: may cost at scale
ENABLE_GOOGLE_PLACES=false
GOOGLE_MAPS_API_KEY=

# NREL AFDC — US-centric fallback (free)
NREL_API_KEY=DEMO_KEY

# ── Cache TTLs ────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
GEO_CACHE_TTL_SECONDS=86400
PROVIDER_CACHE_TTL_SECONDS=900
ADVISOR_CACHE_TTL_SECONDS=3600

# ── Search defaults ───────────────────────────────────────────────────────────
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RESULTS=50
MAX_ZONES_RETURNED=10

# ── Vertex AI Gemini (IAM auth — NO API key) ─────────────────────────────────
# On Cloud Run: runtime SA needs roles/aiplatform.user
# Local dev: run `gcloud auth application-default login`
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001
LLM_ENABLED=true
# Cost: free quota tier on Gemini Flash; may cost at scale

# ── Auth ──────────────────────────────────────────────────────────────────────
REQUIRE_AUTH=false
# API_KEYS=drv-abc123,ops-xyz789
CORS_ORIGINS=*

# ── Ranking weights (must sum to 1.0) ────────────────────────────────────────
RANK_W_WAIT=0.40
RANK_W_FREE=0.25
RANK_W_DIST=0.20
RANK_W_SPEED=0.15

# ── Scoring weights (must sum to 1.0) ────────────────────────────────────────
SCORE_W_EV=0.25
SCORE_W_TRAFFIC=0.20
SCORE_W_COMP_GAP=0.20
SCORE_W_GRID=0.15
SCORE_W_LAND=0.10
SCORE_W_ACCESS=0.10

# ── OCPP (internal charger hardware) ─────────────────────────────────────────
OCPP_WS_URL=ws://localhost:9000
OCPP_SIMULATE_STATIONS=ST001,ST002,ST003,ST004,ST005,ST006
